PROJECT_NAME="RCDO Data Platform"
API_V1_STR="/api/v1"
SECRET_KEY="rcdo-super-secret-production-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL / SQLite dual-support)
